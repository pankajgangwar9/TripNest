@model TourismManagementSystem.Models.Business.TourPackage

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.Title;
}

<div class="container mt-5 mb-5">

    <div class="row g-5">

        <!-- LEFT: IMAGE -->
        <div class="col-md-6">
            <img src="@($"https://source.unsplash.com/800x500/?travel,{Model.Title}")"
                 class="img-fluid rounded shadow-sm"
                 alt="@Model.Title" />
        </div>

        <!-- RIGHT: DETAILS -->
        <div class="col-md-6">

            <h1 class="mb-3">@Model.Title</h1>

            <p class="text-muted mb-4">
                @Model.Description
            </p>

            <!-- INFO BOX -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <div class="row mb-2">
                        <div class="col-6">
                            <strong>Price</strong>
                        </div>
                        <div class="col-6 text-end text-primary fw-bold">
                            ₹@Model.Price
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-6">
                            <strong>Duration</strong>
                        </div>
                        <div class="col-6 text-end">
                            ⏳ @Model.DurationDays days
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-6">
                            <strong>Group Size</strong>
                        </div>
                        <div class="col-6 text-end">
                            👥 Max @Model.MaxGroupSize people
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <strong>Agency</strong>
                        </div>
                        <div class="col-6 text-end">
                            🏢 @Model.Agency.AgencyName
                        </div>
                    </div>

                </div>
            </div>

            <!-- ACTION BUTTONS -->
            <div class="d-flex gap-3">
                <a href="/Booking/Create/@Model.TourPackageId"
                   class="btn btn-main btn-lg">
                    Book This Tour
                </a>

                <a href="/Tour"
                   class="btn btn-outline-secondary btn-lg">
                    Back to Tours
                </a>
            </div>
            <!-- WRITE REVIEW BUTTON -->
            @if (User.Identity.IsAuthenticated && User.IsInRole("Tourist"))
            {
                <div class="mt-3">
                    <a href="@Url.Action("Create", "Review", new { tourId = Model.TourPackageId })"
                       class="btn btn-outline-primary">
                        ⭐ Write a Review
                    </a>
                </div>
            }

            <!-- REVIEWS SECTION -->
            <div class="mt-5">
                <h4>Reviews</h4>

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews)
                    {
                        <div class="border p-3 mb-2 rounded">
                            <strong>User</strong>
                            <br />
                            ⭐ @review.Rating / 5
                            <p>@review.Comment</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No reviews yet.</p>
                }


            </div>

        </div>

    </div>

</div>
