@model IEnumerable<TourismManagementSystem.Models.Business.TourPackage>

<h2 class="page-title">Browse Tours</h2>

<div class="filter-bar">
    <input type="text" placeholder="Search destination..." class="form-control filter-input">
    <select class="form-control filter-input">
        <option>Price</option>
        <option>Low to High</option>
        <option>High to Low</option>
    </select>
    <select class="form-control filter-input">
        <option>Duration</option>
        <option>1–3 Days</option>
        <option>4–7 Days</option>
        <option>7+ Days</option>
    </select>
</div>

<div class="tour-grid">
    @foreach (var t in Model)
    {
        <div class="tour-card">
            <img src="@($"https://source.unsplash.com/400x300/?travel,{Uri.EscapeDataString(t.Title)}")"
                 alt="@t.Title"
                 class="img-fluid" />



            <div class="tour-body">
                <h5>@t.Title</h5>
                <p>@t.Description</p>

                <div class="tour-meta">
                    <span>🏢 @t.Agency.AgencyName</span>
                    <span>⏳ @t.DurationDays days</span>
                </div>

                <div class="tour-footer">
                    <span class="price">₹@t.Price</span>
                    <a href="/Booking/Create/@t.TourPackageId" class="btn btn-primary">Book</a>
                </div>
            </div>
        </div>
    }
</div>
