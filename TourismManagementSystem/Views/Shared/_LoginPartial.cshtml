@using Microsoft.AspNet.Identity
@using TourismManagementSystem.Models

@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
    {
        @Html.AntiForgeryToken()

        string displayName = User.Identity.GetUserName();
        string userId = User.Identity.GetUserId();

        if (!string.IsNullOrEmpty(userId))
        {
            using (var db = new ApplicationDbContext())
            {
                var user = db.Users.Find(userId);
                if (user != null && !string.IsNullOrWhiteSpace(user.FirstName))
                {
                    displayName = user.FirstName +
                                  (string.IsNullOrWhiteSpace(user.LastName)
                                      ? ""
                                      : " " + user.LastName);
                }
            }
        }

        <ul class="navbar-nav navbar-right align-items-center">
            <li class="nav-item">
                <span class="nav-link">Hello @displayName</span>
            </li>

            <li class="nav-item">
                @if (User.IsInRole("Tourist"))
                {
                    <span class="badge bg-primary ms-2">Tourist</span>
                }
                else if (User.IsInRole("Agency"))
                {
                    <span class="badge bg-success ms-2">Agency</span>
                }
                else if (User.IsInRole("Admin"))
                {
                    <span class="badge bg-danger ms-2">Admin</span>
                }
            </li>

            <li class="nav-item ms-3">
                <button type="submit" class="nav-link btn btn-link p-0">
                    Log off
                </button>
            </li>
        </ul>

    }
}
else
{
    <ul class="navbar-nav navbar-right">
        <li class="nav-item">
            @Html.ActionLink("Register", "Register", "Account", null, new { @class = "nav-link" })
        </li>
        <li class="nav-item">
            @Html.ActionLink("Log in", "Login", "Account", null, new { @class = "nav-link" })
        </li>
    </ul>
}
