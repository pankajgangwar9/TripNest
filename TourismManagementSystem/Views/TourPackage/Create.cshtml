@model TourismManagementSystem.Models.Business.TourPackage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Create Tour";
}

<div class="card-ui col-md-8 mx-auto mt-5">

    <h2 class="text-center mb-4">Create Tour Package</h2>

    @if (ViewBag.Errors != null)
    {
        <ul class="text-danger">
            @foreach (string err in ViewBag.Errors)
            {
                <li>@err</li>
            }
        </ul>
    }

    @using (Html.BeginForm())
    {
        <div class="mb-3">
            @Html.LabelFor(m => m.Title)
            @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Description)
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Price)
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.DurationDays)
            @Html.TextBoxFor(m => m.DurationDays, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.MaxGroupSize)
            @Html.TextBoxFor(m => m.MaxGroupSize, new { @class = "form-control" })
        </div>

        <button type="submit" class="btn btn-main w-100">Create Tour</button>
    }

</div>
