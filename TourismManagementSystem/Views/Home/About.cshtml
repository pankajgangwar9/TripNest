@{
    ViewBag.Title = "About TripNest";
}

<!-- HERO SECTION -->
<div class="about-page">
    <section class="about-hero-section">
        <div class="about-hero-overlay">
            <div class="container text-center">
                <h1 class="about-title">About TripNest</h1>
                <p class="about-subtitle">
                    Discover destinations • Book experiences • Travel smarter
                </p>
            </div>
        </div>
    </section>

    <!-- WHO WE ARE -->
    <section class="about-section bg-light">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-md-6">
                    <h2 class="section-title">Who We Are</h2>

                    <p class="section-text">
                        TripNest is a modern tourism management platform designed to bridge the
                        gap between travelers and trusted travel agencies around the world.
                        We bring technology and travel together to create meaningful and
                        hassle-free experiences.
                    </p>

                    <p class="section-text">
                        Whether you are planning a solo adventure, a family vacation, or a
                        group tour, TripNest helps you explore destinations, compare tour
                        packages, and make secure bookings with confidence.
                    </p>

                    <p class="section-text">
                        Our platform focuses on transparency, reliability, and ease of use.
                        Every travel agency listed on TripNest is carefully verified to ensure
                        quality service, accurate information, and customer satisfaction.
                    </p>

                    <p class="section-text">
                        From discovering new destinations to managing bookings and payments,
                        TripNest simplifies every step of your journey. Our goal is to remove
                        the stress from travel planning so you can focus on creating
                        unforgettable memories.
                    </p>

                    <p class="section-text">
                        With a user-friendly interface, secure payment systems, and dedicated
                        customer support, TripNest is your trusted companion for smarter,
                        safer, and more enjoyable travel experiences.
                    </p>
                </div>


                <div class="col-md-6">
                    <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e"
                         class="img-fluid rounded-4 shadow-lg" />
                </div>
            </div>
        </div>
    </section>

    <!-- MISSION & VISION -->
    <section class="about-section bg-gradient">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="info-card">
                        <h3>🎯 Our Mission</h3>
                        <p>
                            To simplify travel planning by providing a secure, reliable
                            platform where tourists and verified agencies connect effortlessly.
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-card">
                        <h3>🚀 Our Vision</h3>
                        <p>
                            To become a trusted global travel marketplace empowering agencies
                            and delivering unforgettable journeys worldwide.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="about-section bg-light text-center">
