@{
    ViewBag.Title = "About";
}

<div class="container mt-5">

    <!-- Hero Section -->
    <div class="about-hero text-center mb-5">
        <h1 class="display-4 fw-bold">About TripNest</h1>
        <p class="lead">Discover. Book. Explore.</p>
    </div>

    <!-- Who We Are -->
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h2>Who We Are</h2>
            <p>
                TripNest is a modern Tourism Management System designed to connect travelers with
                trusted travel agencies. We make it easy to explore destinations, compare tours,
                and book trips securely.
            </p>
            <p>
                Whether you are planning a vacation, adventure, or business trip — TripNest helps you
                find the best experiences at the best price.
            </p>
        </div>
        <div class="col-md-6">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e"
                 class="img-fluid rounded shadow" />
        </div>
    </div>

    <!-- Mission & Vision -->
    <div class="row mb-5">
        <div class="col-md-6">
            <div class="card p-4 shadow-sm h-100">
                <h3>🎯 Our Mission</h3>
                <p>
                    To make travel planning easy, transparent and enjoyable by providing a reliable
                    platform where tourists and agencies can connect.
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-4 shadow-sm h-100">
                <h3>🚀 Our Vision</h3>
                <p>
                    To become a leading digital travel marketplace that empowers agencies
                    and gives travelers unforgettable journeys worldwide.
                </p>
            </div>
        </div>
    </div>

    <!-- Why TripNest -->
    <div class="text-center mb-5">
        <h2>Why Choose TripNest?</h2>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card p-3 shadow-sm">
                    <h4>🔒 Secure Booking</h4>
                    <p>Safe and transparent booking system.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 shadow-sm">
                    <h4>🏢 Trusted Agencies</h4>
                    <p>Only verified agencies can list tours.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 shadow-sm">
                    <h4>🌍 Global Destinations</h4>
                    <p>Explore tours from different locations.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Team -->
    <div class="text-center mb-5">
        <h2>Meet Our Team</h2>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card p-4 shadow-sm">
                    <img src="https://ui-avatars.com/api/?name=Prapti+Tripathi&background=0d6efd&color=fff"
                         class="rounded-circle mb-3" width="100" />
                    <h5>Prapti Tripathi</h5>
                    <p>Project Lead</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-4 shadow-sm">
                    <img src="https://ui-avatars.com/api/?name=Roshan+Lama&background=198754&color=fff"
                         class="rounded-circle mb-3" width="100" />
                    <h5>Roshan Lama</h5>
                    <p>Backend Developer</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-4 shadow-sm">
                    <img src="https://ui-avatars.com/api/?name=Muhammad+Ali&background=f39c12&color=fff"
                         class="rounded-circle mb-3" width="100" />
                    <h5>Muhammad Ali</h5>
                    <p>UI / UX Designer</p>
                </div>
            </div>
        </div>
    </div>

</div>
