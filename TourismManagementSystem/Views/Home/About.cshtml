                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">🌍</div>
                        <h5>Global Reach</h5>
                        <p>Explore destinations across regions.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

