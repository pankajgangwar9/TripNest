@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Dashboard</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Total Users</h5>
            <h2>@ViewBag.Users</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Total Agencies</h5>
            <h2>@ViewBag.Agencies</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Total Tours</h5>
            <h2>@ViewBag.Tours</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Total Bookings</h5>
            <h2>@ViewBag.Bookings</h2>
        </div>
    </div>

</div>
