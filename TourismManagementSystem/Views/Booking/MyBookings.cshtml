@model IEnumerable<TourismManagementSystem.Models.Business.Booking>

<h2 class="page-title">My Bookings</h2>

<div class="booking-grid">
    @foreach (var b in Model)
    {
        <div class="booking-card">
            <h5>@b.TourPackage.Title</h5>
            <p><b>Date:</b> @b.BookingDate.ToShortDateString()</p>
            <p><b>Price:</b> ₹@b.TourPackage.Price</p>

            <span class="status @b.Status.ToString().ToLower()">
                @b.Status
            </span>

            @if (b.Status == TourismManagementSystem.Models.Business.BookingStatus.Pending)
            {
                <a href="/Payment/Pay?bookingId=@b.BookingId" class="btn btn-success mt-2">
                    Pay Now
                </a>
            }
        </div>
    }
</div>
