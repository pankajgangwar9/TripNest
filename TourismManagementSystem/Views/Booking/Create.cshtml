@model TourismManagementSystem.Models.Business.TourPackage

@{
    ViewBag.Title = "Confirm Booking";
}

<div class="container mt-5">

    <h2 class="page-title text-center mb-4">Confirm Booking</h2>

    <div class="confirm-card">

        <div class="confirm-header">
            <h4>@Model.Title</h4>
            <span class="confirm-price">₹@Model.Price</span>
        </div>

        <div class="confirm-body">
            <p class="text-muted">
                @(Model.Description?.Length > 120
                    ? Model.Description.Substring(0, 120) + "..."
                    : Model.Description)
            </p>

            <div class="confirm-details">
                <div>
                    <strong>Duration</strong>
                    <p>⏳ @Model.DurationDays days</p>
                </div>
            </div>
        </div>

        @using (Html.BeginForm("Confirm", "Booking", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.Hidden("tourPackageId", Model.TourPackageId)

            <div class="confirm-footer">
                <a href="/Tour" class="btn btn-outline-secondary">
                    ← Back
                </a>

                <button type="submit" class="btn btn-success btn-lg">
                    Confirm Booking
                </button>
            </div>
        }
    </div>

</div>
